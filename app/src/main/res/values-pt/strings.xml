    <string name="help_step1_detail">Tenha o OBS Studio instalado (Windows, versão 32.x).</string>
    <string name="help_step1_action">Baixar o OBS Studio</string>
    <string name="help_step2_title">Plugin Niriun</string>
    <string name="help_step2_detail">Baixe o instalador do plugin e execute com o OBS fechado.</string>
