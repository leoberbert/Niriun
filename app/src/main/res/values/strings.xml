    <string name="help_intro">To use this phone in OBS Studio, do this once on the computer:</string>
    <string name="help_step1_title">OBS Studio 32 or newer</string>
    <string name="help_step1_detail">Have OBS Studio installed (Windows, version 32 or newer, e.g. 33).</string>
    <string name="help_step1_action">Download OBS Studio</string>
    <string name="help_step2_title">Niriun plugin</string>
    <string name="help_step2_detail">Download the plugin installer and run it with OBS closed.</string>
    <string name="help_step2_action">Download the plugin</string>
    <string name="help_step3_title">Add the source</string>
    <string name="help_step3_detail">In OBS: Sources, +, Niriun. In Device pick this phone (it shows up by itself on the same Wi-Fi; by cable pick the [USB] entry, or choose Use WiFi IP and type the address from Details). Press Activate.</string>
    <string name="help_step4_title">Watch the tally</string>
    <string name="help_step4_detail">Put the source in a scene: the border turns magenta when it is on air and amber in preview.</string>
    <string name="help_footer">Open Niriun and press Start before activating the source in OBS.</string>
