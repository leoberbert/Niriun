    <string name="welcome_title">Your phone as a wireless webcam</string>
    <string name="welcome_subtitle">Send camera and microphone to your computer over Wi-Fi or USB tethering. No account, no cloud.</string>
    <string name="welcome_step1_title">Open the computer app</string>
    <string name="welcome_step1_detail">Run the Iriun Webcam desktop app on the same Wi-Fi network as this phone.</string>
    <string name="welcome_step2_title">Pick this phone</string>
    <string name="welcome_step2_detail">It shows up automatically. If not, type the address shown in Details.</string>
    <string name="welcome_step3_title">Use it as a camera</string>
    <string name="welcome_step3_detail">Choose it in your video-call or recording app. The picture follows how you hold the phone.</string>
    <string name="welcome_privacy">Video and audio only travel to computers on your local network.</string>
    <string name="welcome_allow_and_start">Allow and start</string>

    <string name="permission_title">Permissions needed</string>
    <string name="permission_body">Niriun needs the camera to send video and, on Android 17+, local network access so your computer can find this phone. The microphone (audio) and notifications (status) are optional.</string>
